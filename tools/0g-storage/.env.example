# 0G Storage uploader — environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# 0G Galileo testnet RPC endpoint
RPC_URL=https://evmrpc-testnet.0g.ai

# 0G Storage indexer (Turbo network — recommended for testnet)
STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai

# Wallet private key for signing storage upload transactions.
# Use a dedicated dev wallet; never use a wallet that holds real funds.
PRIVATE_KEY=your_private_key_here